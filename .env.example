# Supabase PostgreSQL connection string (Dashboard > Connect > Session pooler).
# Use the Supabase Session Pooler URL. If Node reports a self-signed
# certificate, download the Supabase database CA certificate and set its
# absolute path in sslrootcert. Do not use the anon/service-role API key here.
DATABASE_URL='postgresql://postgres.<PROJECT_REF>:[URL_ENCODED_PASSWORD]@<POOLER_HOST>:5432/postgres?sslmode=verify-full&sslrootcert=/absolute/path/to/supabase-ca.crt'

# Use a unique random value of at least 32 characters in production.
SESSION_SECRET=

# Public app URL (no trailing slash), used for referral and reset links.
PORTAL_PUBLIC_URL=

# Optional exact browser origin for credentialed cross-origin requests.
# For split Vercel/Render hosting, set this to the Vercel site's origin,
# such as https://portal.example.com (no trailing slash).
APP_ORIGIN=

# Optional first-admin bootstrap values. 
UPTOWN_ADMIN_EMAIL=
UPTOWN_ADMIN_PHONE=
UPTOWN_ADMIN_PASSWORD=

# Optional SMTP settings for password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Supplied by the managed runtime when running the server.
PORT=5000

# Optional Vite public base path. Use "/" for local development.
BASE_PATH=/

# Frontend API origin for split hosting (no /api suffix). Leave empty locally
# to use the Vite development proxy.
VITE_API_URL=

# Local Vite proxy target for the Express API.
API_URL=http://127.0.0.1:5001
